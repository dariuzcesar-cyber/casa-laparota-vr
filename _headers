# Cloudflare Pages — política de caché
# Regla: el HTML y los archivos compartidos SIEMPRE se revalidan;
# los tiles del 360°, que nunca cambian, se cachean un año.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# --- Nunca servir HTML viejo ---
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/tours/*/index.html
  Cache-Control: public, max-age=0, must-revalidate

# --- Tema y script compartidos: cambian en cada rediseño ---
/assets/tour-theme.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/tour-enhance.js
  Cache-Control: public, max-age=0, must-revalidate

# --- Datos del tour ---
/tours/*/data.js
  Cache-Control: public, max-age=0, must-revalidate
/tours/*/index.js
  Cache-Control: public, max-age=0, must-revalidate
/tours/*/style.css
  Cache-Control: public, max-age=0, must-revalidate

# --- Imágenes de marca: cambian poco ---
/assets/*.png
  Cache-Control: public, max-age=86400
/assets/*.jpg
  Cache-Control: public, max-age=86400
/assets/*.jpeg
  Cache-Control: public, max-age=86400

# --- Tiles del panorama: inmutables ---
/tours/*/tiles/*
  Cache-Control: public, max-age=31536000, immutable
/tours/*/vendor/*
  Cache-Control: public, max-age=31536000, immutable
